# Base URL used by the browser to reach the API.
# Leave empty to use the Vite dev/preview proxy at "/api" (no CORS needed).
# Set to an absolute URL (e.g. http://localhost:5297) when the API is served
# from another origin - the backend then has to allow this origin via CORS.
VITE_API_BASE_URL=

# Backend address the Vite dev/preview proxy forwards "/api/*" to.
VITE_API_PROXY_TARGET=http://localhost:5297
