# Base URL used by the browser to reach the API.
# Leave this commented out (or blank) to use the Vite dev/preview proxy at "/api"
# (no CORS needed). A blank value is treated as "not set".
# Set to an absolute URL (e.g. https://localhost:7072) when the API is served
# from another origin - the backend then has to allow this origin via CORS.
# VITE_API_BASE_URL=

# Backend address the Vite dev/preview proxy forwards "/api/*" to.
VITE_API_PROXY_TARGET=https://localhost:7072
